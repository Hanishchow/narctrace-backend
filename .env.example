# narctrace-backend environment (copy to .env; .env is gitignored)
# --- Port sync contract (MUST match frontend .env.example) ---
PORT=8000
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false
MAX_UPLOAD_BYTES=10485760
EVIDENCE_SIGNING_KEY=replace-with-a-long-random-server-side-secret

# --- Persistence backend: local (SQLite + filesystem, no creds) | insforge ---
STORE_BACKEND=local

# --- InsForge (server-side secrets — NEVER ship to frontend) ---
INSFORGE_API_URL=https://your-project.insforge.app
INSFORGE_SERVICE_KEY=replace-me
INSFORGE_EVIDENCE_BUCKET=evidence

# --- App ---
APP_VERSION=0.1.0
